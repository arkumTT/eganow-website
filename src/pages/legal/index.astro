---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { LEGAL_DOCS, LEGAL_DRAFT } from '../../data/legal-status';
---
<Base title="Legal | Eganow" description="Eganow’s terms, privacy, cookie, AML and complaints documents." noindex={LEGAL_DRAFT}>
  <Header world="neutral" />
  <main id="main">
    <section class="idx" aria-labelledby="lg-t">
      <div class="idx__in">
        <p class="overline">Legal</p>
        <h1 id="lg-t" class="display-lg">The small print, made clear.</h1>
        <p class="body-lg">Everything you should know about how Eganow works with you and your information.</p>
        <ul class="docs">
          {LEGAL_DOCS.map((d) => (
            <li><a href={d.href}><b>{d.title}</b><span>{d.blurb}</span><i aria-hidden="true">→</i></a></li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Base>
<style>
  .idx { background: var(--surface); padding: var(--space-16) 0 var(--space-24); }
  .idx__in { max-width: 1000px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 48px); display: grid; gap: var(--space-4); }
  .idx__in > .display-lg { margin-top: 0; max-width: 18ch; }
  .docs { list-style: none; margin: var(--space-8) 0 0; padding: 0; display: grid; gap: var(--space-3); }
  .docs a { display: grid; grid-template-columns: 1fr auto; gap: 2px var(--space-4); align-items: center; padding: var(--space-6); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface-raised); text-decoration: none; transition: border-color .2s, transform .2s var(--ease-out); }
  .docs a:hover { border-color: var(--neutral-700); transform: translateY(-2px); }
  .docs b { font: 600 20px/28px var(--font-display); } .docs span { grid-column: 1; color: var(--text-muted); } .docs i { grid-row: 1 / span 2; grid-column: 2; font-style: normal; font-size: 22px; }
  @media (prefers-reduced-motion: reduce) { .docs a { transition: none; } }
</style>
