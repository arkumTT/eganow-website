---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<Base title="Thanks — we’ve got your message | Eganow" description="Your message has been sent to the Eganow team." noindex>
  <Header world="neutral" />
  <main id="main">
    <section class="ty" aria-labelledby="ty-t">
      <div class="ty__in">
        <span class="tick" aria-hidden="true">✓</span>
        <h1 id="ty-t" class="display-lg" tabindex="-1">Thanks. We’ve got your message.</h1>
        <p class="body-lg">Our team will get back to you by email. If it’s urgent, the Help centre has quick answers.</p>
        <div class="cta">
          <a class="btn btn--red" href="/">Back to Eganow</a>
          <a class="btn btn--blue" href="/business"><span class="dot"></span>Explore Business</a>
        </div>
        <p class="note">Never share your PIN or password with anyone, including us.</p>
      </div>
    </section>
  </main>
  <Footer />
</Base>
<style>
  .ty { min-height: 64vh; display: grid; place-items: center; padding: var(--space-24) clamp(16px, 4vw, 48px); background: var(--surface); }
  .ty__in { max-width: 560px; display: grid; gap: var(--space-4); justify-items: center; text-align: center; }
  .tick { display: grid; place-items: center; width: 72px; height: 72px; border-radius: 50%; background: #12805c; color: #fff; font: 700 36px/1 var(--font-display); }
  .ty__in .cta { justify-content: center; } .note { margin: 0; font-size: 13px; color: var(--text-subtle); }
</style>
<script>
  // Move focus to the heading so screen-reader users hear the confirmation
  (document.getElementById('ty-t') as HTMLElement | null)?.focus({ preventScroll: true });
</script>
