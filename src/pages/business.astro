---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BizVisuals from '../components/BizVisuals.astro';

const services = [
  { id: 'bizcollect', n: '01', name: 'BizCollect', theme: 'light', vis: 'collect', title: 'Get paid in seconds.',
    body: 'Collect from mobile money, cards and bank transfers. Pay out just as fast, and watch every transaction on one dashboard.',
    chips: ['API', 'Hosted Checkout', 'Payment Link', 'USSD'], href: '/business/bizcollect' },
  { id: 'egapos', n: '02', name: 'EgaPOS', theme: 'dark', vis: 'pos', title: 'Tap. Paid.',
    body: 'Get POS devices from Eganow and manage every terminal, receipt and settlement from one platform.',
    chips: ['Device issuing', 'POS management', 'Reports'], href: '/business/egapos' },
  { id: 'card-issuing', n: '03', name: 'Card Issuing', theme: 'blue', vis: 'cards', title: 'Issue cards. Control spend.',
    body: 'Mastercard virtual and physical cards for your team’s expenses, or become a re-issuer and offer cards to your own customers, from the portal or by API.',
    chips: ['Team expenses', 'Re-issuer programme', 'API'], href: '/business/card-issuing' },
  { id: 'agency-banking', n: '04', name: 'Agency Banking', theme: 'light', vis: 'agency', title: 'Cash in. Cash out. Anywhere.',
    body: 'Turn your shop into a service point. Let customers deposit and withdraw cash to their mobile wallet or bank account.',
    chips: ['Deposits', 'Withdrawals', 'Wallet & bank'], href: '/business/agency-banking' },
  { id: 'bulk-messaging', n: '05', name: 'Bulk Messaging', theme: 'dark', vis: 'messaging', title: 'Reach everyone. Instantly.',
    body: 'Send bulk SMS and email to your customers, with delivery reports so you know it landed.',
    chips: ['Bulk SMS', 'Bulk email', 'Delivery reports'], href: '/business/bulk-messaging' },
  { id: 'egahub', n: '06', name: 'Egahub', theme: 'blue', vis: 'hub', title: 'Your business, in your pocket.',
    body: 'Everything above, in one mobile app. Collect, pay out, issue cards and message customers from anywhere.',
    chips: ['iOS', 'Android'], href: '/business/egahub' },
] as const;
const s3 = [['Simple', 'One platform. One dashboard. One integration.'], ['Speed', 'Collect and pay out in seconds, not days.'], ['Secure', 'Licensed, monitored and built to protect every transaction.']];
---
<Base world="business" title="Eganow Business — Get paid in seconds" description="Collections, payouts, POS, Mastercard card issuing, agency banking, bulk messaging and the Egahub app. Simple. Speed. Secure.">
  <Header world="business" />
  <main id="main">
    <!-- HERO -->
    <section class="hero" aria-labelledby="biz-title">
      <div class="hero__in">
        <div class="hero__copy">
          <p class="overline">Eganow Business</p>
          <h1 id="biz-title" class="display-xl">Business, made simple.</h1>
          <p class="body-lg">Collect. Pay out. Issue cards. Accept at the counter. One platform for every way you get paid.</p>
          <div class="cta">
            <a class="btn btn--blue-solid" href="/contact?topic=business">Open a business account</a>
            <a class="btn btn--ghost" href="/contact?topic=sales">Talk to sales</a>
          </div>
          <a class="swap" href="/">Looking for the personal app? <span>Switch to Personal →</span></a>
        </div>
        <div class="hero__vis" aria-hidden="true"><div class="vis vis--hero"><BizVisuals name="collect" /></div></div>
      </div>
      <ul class="s3">{s3.map(([h, p]) => <li><b>{h}</b><span>{p}</span></li>)}</ul>
    </section>

    <!-- SERVICE STORY -->
    <section class="biz" data-biz aria-label="Eganow Business services">
      <div class="stage">
        {services.map((s, i) => (
          <article class="panel" id={s.id} data-theme={s.theme} aria-labelledby={`${s.id}-t`}>
            <div class="copy">
              <p class="overline" data-in>{s.n} · {s.name}</p>
              <h2 id={`${s.id}-t`} class="display-lg" data-in>{s.title}</h2>
              <p class="body-lg" data-in>{s.body}</p>
              <ul class="tags" data-in>{s.chips.map((c) => <li>{c}</li>)}</ul>
              <a class="more" href={s.href} data-in>Explore {s.name} <span aria-hidden="true">→</span></a>
            </div>
            <div class="vis" aria-hidden="true"><BizVisuals name={s.vis} /></div>
          </article>
        ))}
        <nav class="rail" aria-label="Services">
          <ol>{services.map((s, i) => <li><a href={`#${s.id}`} data-i={i} aria-label={s.name}><b>{s.n}</b><span>{s.name}</span></a></li>)}</ol>
        </nav>
      </div>
    </section>

    <!-- DEVELOPERS -->
    <section class="dev" aria-labelledby="dev-t">
      <div class="dev__in">
        <div>
          <p class="overline">For developers</p>
          <h2 id="dev-t" class="display-lg">Integrate in an afternoon.</h2>
          <p class="body-lg">One API for collections, payouts and cards. Test in the sandbox, go live when you are ready.</p>
          <div class="cta"><a class="btn btn--blue-solid" href="/business/developers">Read the docs</a><a class="btn btn--ghost-inv" href="/contact?topic=sandbox">Get sandbox access</a></div>
        </div>
        <div class="code">
          <div class="code__bar"><span>Illustrative example</span><button type="button" data-copy>Copy</button></div>
<pre><code id="snip">POST /v1/collections
&#123;
  "amount": 250.00,
  "currency": "GHS",
  "method": "mobile_money",
  "callback_url": "https://yourshop.com/hook"
&#125;</code></pre>
        </div>
      </div>
    </section>

    <!-- TRUST + CTA -->
    <section class="trust" aria-labelledby="trust-t">
      <h2 id="trust-t" class="sr-only">Why businesses trust Eganow</h2>
      <ul><li><b>Bank of Ghana</b><span>licensed Payment Service Provider</span></li><li><b>Mastercard</b><span>virtual and physical card issuing</span></li><li><b>Secure by design</b><span>encrypted, monitored, audited</span></li></ul>
    </section>
    <section class="final">
      <h2 class="display-lg">Ready when you are.</h2>
      <p class="body-lg">Open an account in minutes, or talk to our team.</p>
      <div class="cta"><a class="btn btn--blue-solid" href="/contact?topic=business">Open a business account</a><a class="btn btn--ghost" href="/contact?topic=sales">Talk to sales</a></div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }

  /* HERO */
  .hero { position: relative; overflow: hidden; background: var(--surface); }
  .hero::before { content: ""; position: absolute; top: 0; right: 0; width: 56%; height: 100%; background: var(--eganow-blue); clip-path: polygon(30% 0, 100% 0, 100% 100%, 0 100%); }
  .hero::after { content: ""; position: absolute; top: 0; right: 0; width: 64%; height: 100%; background: #9fd0ff; opacity: .5; clip-path: polygon(34% 0, 100% 0, 100% 100%, 0 100%); z-index: 0; }
  .hero__in { position: relative; z-index: 1; max-width: 1240px; margin: 0 auto; padding: var(--space-16) clamp(16px, 4vw, 48px) var(--space-8); display: grid; gap: var(--space-8); align-items: center; }
  .hero__copy { display: grid; gap: var(--space-4); max-width: 560px; justify-items: start; }
  .hero__copy .cta { margin-top: var(--space-2); }
  .swap { font-size: 14px; color: var(--text-muted); text-decoration: none; } .swap span { color: var(--eganow-red); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .vis--hero { width: min(100%, 520px); aspect-ratio: 1; margin-inline: auto; position: relative; container-type: inline-size; }
  .s3 { position: relative; z-index: 1; max-width: 1240px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 48px) var(--space-12); list-style: none; display: grid; gap: var(--space-3); }
  .s3 li { display: grid; gap: 2px; padding: var(--space-4); background: rgb(255 255 255 / .9); border: 1px solid var(--border); border-radius: var(--radius-md); }
  .s3 b { font: 600 18px/24px var(--font-display); } .s3 span { color: var(--text-muted); font-size: 14px; line-height: 20px; }
  @media (min-width: 900px) { .hero__in { grid-template-columns: 1.05fr 1fr; padding-top: var(--space-24); } .s3 { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 899px) { .hero::before, .hero::after { width: 100%; height: 46%; top: auto; bottom: 0; clip-path: polygon(0 30%, 100% 0, 100% 100%, 0 100%); } }

  /* SERVICE PANELS: static (stacked) by default */
  .biz { position: relative; }
  .rail { display: none; }
  .panel { position: relative; display: grid; gap: var(--space-8); align-items: center; padding: var(--space-16) clamp(16px, 5vw, 80px); overflow: hidden; }
  .copy { display: grid; gap: var(--space-4); max-width: 540px; justify-items: start; }
  .vis { position: relative; width: min(100%, 520px); aspect-ratio: 1; margin-inline: auto; container-type: inline-size; }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { padding: 6px 14px; border-radius: 999px; font: 500 13px/20px var(--font-display); border: 1px solid currentColor; }
  .more { font: 600 16px/24px var(--font-display); text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 2px; }
  .panel[data-theme="light"] { background: var(--surface); color: var(--text); }
  .panel[data-theme="light"] .vis::before, .panel[data-theme="blue"] .vis::before, .panel[data-theme="dark"] .vis::before { content: ""; position: absolute; inset: 6% 2% 4% 8%; z-index: -1; border-radius: 28% 8% 28% 8%; transform: rotate(-4deg); }
  .panel[data-theme="light"] .vis::before { background: var(--eganow-blue); }
  .panel[data-theme="dark"] { background: var(--neutral-950); color: #fff; }
  .panel[data-theme="dark"] .overline { color: var(--neutral-300); } .panel[data-theme="dark"] .body-lg { color: var(--neutral-300); }
  .panel[data-theme="dark"] .vis::before { background: linear-gradient(135deg, #123b6b, #0b4f99); }
  .panel[data-theme="blue"] { background: var(--eganow-blue); color: var(--neutral-950); }
  .panel[data-theme="blue"] .display-lg { color: #fff; } .panel[data-theme="blue"] .overline, .panel[data-theme="blue"] .body-lg { color: var(--neutral-950); }
  .panel[data-theme="blue"] .overline::before { background: #fff; }
  .panel[data-theme="blue"] .vis::before { background: rgb(255 255 255 / .22); }
  .vis { isolation: isolate; }
  @media (min-width: 900px) { .panel { grid-template-columns: 1fr 1fr; } }

  /* LIVE: pinned stage with wiping panels */
  :global(.live) .biz { height: 640vh; }
  :global(.live) .stage { position: sticky; top: var(--header-h); height: calc(100svh - var(--header-h)); overflow: hidden; --sh: calc(100svh - var(--header-h)); }
  :global(.live) .panel { position: absolute; inset: 0; padding: 0 clamp(72px, 9vw, 130px) 0 clamp(16px, 5vw, 80px); }
  :global(.live) .panel:not(:first-of-type) { clip-path: polygon(0 100%, 100% 100%, 100% 100%, 0 100%); }
  :global(.live) .vis { width: min(100%, 560px, calc(var(--sh) * .82)); }
  :global(.live) .rail { display: block; position: absolute; right: clamp(8px, 2vw, 28px); top: 50%; translate: 0 -50%; z-index: 5; }
  .rail ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .rail a { display: flex; align-items: center; justify-content: flex-end; gap: 10px; text-decoration: none; font: 600 12px/16px var(--font-display); color: var(--neutral-500); padding: 6px 4px; mix-blend-mode: normal; }
  .rail a span { display: none; } .rail a b { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; border: 2px solid currentColor; font-size: 11px; background: var(--surface); transition: background-color .25s, color .25s, border-color .25s; }
  .rail a.on b { background: var(--eganow-blue); border-color: var(--eganow-blue); color: var(--neutral-950); }
  .rail a:hover span, .rail a.on span { display: inline; }
  .rail a span { color: var(--neutral-900); background: var(--surface); padding: 3px 8px; border-radius: 6px; }
  @media (max-width: 899px) {
    :global(.live) .panel { padding: 0 clamp(16px, 5vw, 32px); grid-template-columns: 1fr; grid-template-rows: 44% 1fr; gap: 0; align-items: start; }
    :global(.live) .panel .vis { order: -1; align-self: center; width: min(100%, 340px, calc(var(--sh) * .4)); }
    :global(.live) .panel .copy { gap: 10px; padding-top: 8px; align-self: start; }
    :global(.live) .panel .display-lg { font-size: clamp(26px, 7.4vw, 34px); }
    :global(.live) .panel .body-lg { font-size: 15px; line-height: 22px; }
    :global(.live) .panel .tags { display: none; }
    :global(.live) .rail { right: 4px; top: 12px; translate: none; }
    :global(.live) .rail ol { gap: 4px; } .rail a b { width: 22px; height: 22px; font-size: 9px; border-width: 1.5px; } .rail a span { display: none !important; }
  }
  @media (max-width: 899px) and (max-height: 700px) { :global(.live) .panel .body-lg { display: none; } }

  /* DEV */
  .dev { background: var(--neutral-900); color: #fff; padding: var(--space-24) clamp(16px, 4vw, 48px); }
  .dev__in { max-width: 1200px; margin: 0 auto; display: grid; gap: var(--space-8); align-items: center; }
  .dev .overline { color: var(--neutral-300); } .dev .body-lg { color: var(--neutral-300); margin-top: var(--space-4); } .dev .display-lg { margin-top: var(--space-3); }
  .code { background: var(--neutral-950); border: 1px solid var(--neutral-700); border-radius: var(--radius-md); overflow: hidden; min-width: 0; }
  .code__bar { display: flex; justify-content: space-between; align-items: center; padding: 10px 16px; border-bottom: 1px solid var(--neutral-700); font-size: 12px; color: var(--neutral-400); }
  .code__bar button { font: 600 12px/1 var(--font-display); color: #fff; background: var(--neutral-700); border: 0; border-radius: 99px; padding: 8px 14px; cursor: pointer; }
  pre { margin: 0; padding: 20px 16px; overflow-x: auto; font: 400 13.5px/22px ui-monospace, "SF Mono", Menlo, Consolas, monospace; color: #cfe5ff; }
  @media (min-width: 900px) { .dev__in { grid-template-columns: 1fr 1fr; } }

  /* TRUST + FINAL */
  .trust { background: var(--surface); padding: var(--space-12) clamp(16px, 4vw, 48px); border-bottom: 1px solid var(--border); }
  .trust ul { max-width: 1200px; margin: 0 auto; padding: 0; list-style: none; display: grid; gap: var(--space-6); }
  .trust li { display: grid; gap: 2px; } .trust b { font: 600 20px/28px var(--font-display); } .trust span { color: var(--text-muted); font-size: 14px; }
  @media (min-width: 900px) { .trust ul { grid-template-columns: repeat(3, 1fr); } }
  .final { padding: var(--space-24) clamp(16px, 4vw, 48px); text-align: center; display: grid; justify-items: center; gap: var(--space-4); }
  .final .cta { justify-content: center; }
</style>

<script>
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy]');
  copyBtn?.addEventListener('click', async () => {
    const t = document.getElementById('snip')?.textContent ?? '';
    try { await navigator.clipboard.writeText(t); copyBtn.textContent = 'Copied'; } catch { copyBtn.textContent = 'Press Ctrl+C'; }
    setTimeout(() => (copyBtn.textContent = 'Copy'), 1800);
  });

  const root = document.documentElement;
  const el = document.querySelector<HTMLElement>('[data-biz]');
  if (el && root.classList.contains('live')) {
    const start = () =>
      Promise.all([import('gsap'), import('gsap/ScrollTrigger')]).then(([{ gsap }, { ScrollTrigger }]) => {
        gsap.registerPlugin(ScrollTrigger);
        const panels = Array.from(el.querySelectorAll<HTMLElement>('.panel'));
        const links = Array.from(el.querySelectorAll<HTMLAnchorElement>('.rail a'));
        const N = panels.length;
        const FULL = 'polygon(0 0, 100% 0, 100% 100%, 0 100%)';
        const setActive = (i: number) => {
          panels.forEach((p, k) => { p.classList.toggle('is-active', k === i); p.inert = k !== i; });
          links.forEach((a, k) => { a.classList.toggle('on', k === i); k === i ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current'); });
        };
        setActive(0);

        const tl = gsap.timeline({ defaults: { ease: 'power2.out' }, paused: true });
        panels.forEach((p, i) => {
          const items = p.querySelectorAll('[data-in]');
          const vis = p.querySelector('.vis');
          if (i > 0) {
            tl.to(p, { clipPath: FULL, duration: 0.55, ease: 'power2.inOut' }, i - 0.3);
            tl.fromTo(items, { y: 40, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.4, stagger: 0.05 }, i - 0.05);
            tl.fromTo(vis, { scale: 0.9, rotate: -3, autoAlpha: 0 }, { scale: 1, rotate: 0, autoAlpha: 1, duration: 0.6 }, i - 0.15);
          }
        });
        tl.to({}, { duration: 0.75 }, N - 0.75); // hold so the timeline is exactly N long

        const st = ScrollTrigger.create({
          trigger: el, start: 'top top+=64', end: 'bottom bottom', animation: tl, scrub: 0.6,
          onUpdate: (self) => setActive(Math.min(N - 1, Math.max(0, Math.floor(self.progress * N + 0.3)))),
        });

        // Rail + hash links jump to the scroll position where that panel is settled
        const go = (i: number) => window.scrollTo({ top: st.start + ((i + 0.3) / N) * (st.end - st.start), behavior: 'smooth' });
        links.forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); go(Number(a.dataset.i)); }));
        const hashIdx = () => panels.findIndex((p) => '#' + p.id === location.hash);
        addEventListener('hashchange', () => { const i = hashIdx(); if (i >= 0) go(i); });
        if (hashIdx() >= 0) setTimeout(() => go(hashIdx()), 300);
      });
    ('requestIdleCallback' in window ? (window as any).requestIdleCallback(start) : setTimeout(start, 1));
  }
</script>
