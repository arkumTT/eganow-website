---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BizVisuals from '../../components/BizVisuals.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import Steps from '../../components/Steps.astro';
import CardGrid from '../../components/CardGrid.astro';
import PriceTeaser from '../../components/PriceTeaser.astro';
import Faq from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';

// NOTE (content): everything below is drafted from the product brief. Items marked TODO(verify) must be
// confirmed against the live product / eganow.com before launch: payment methods, settlement timing, fees, API shape.

const s3 = [
  ['Simple', 'One integration or one link. Every way your customers pay, in one place.'],
  ['Speed', 'Customers pay in a few taps and you see it on your dashboard as it happens.'],
  ['Secure', 'Licensed, monitored and built to protect every transaction.'],
];

const apiSnippet = `POST /v1/collections
{
  "amount": 250.00,
  "currency": "GHS",
  "method": "mobile_money",
  "reference": "ORDER-1042",
  "callback_url": "https://yourshop.com/hook"
}

200 OK
{
  "id": "col_8f2a1c",
  "status": "pending",
  "checkout_url": "https://..."
}`;

const tabs = [
  { id: 'api', label: 'API', title: 'Build it into your app.', body: 'One API to request a payment and get notified when it lands. Test in the sandbox, then go live.', cta: ['Read the docs', '/business/developers'] },
  { id: 'checkout', label: 'Hosted Checkout', title: 'A checkout you don’t have to build.', body: 'Send customers to a secure Eganow page. They pick how to pay, you get the result. No payment code on your side.', cta: ['Talk to sales', '/contact?topic=sales'] },
  { id: 'link', label: 'Payment Link', title: 'Share a link. Get paid.', body: 'Create a link in seconds and send it on WhatsApp, SMS or email. No website needed.', cta: ['Open a business account', '/contact?topic=business'] },
  { id: 'ussd', label: 'USSD', title: 'Works on any phone.', body: 'Customers without a smartphone or data can still pay by dialling a code and approving on their phone.', cta: ['Talk to sales', '/contact?topic=sales'] },
] as const;

const steps = [
  ['Open an account', 'Register your business and get verified.'],
  ['Choose how to collect', 'Plug in the API, use Hosted Checkout, or share a Payment Link or USSD code.'],
  ['Customers pay', 'They choose their method and approve in a few taps.'],
  ['Track and settle', 'See every transaction on your dashboard and pay out when you need to.'],
];

const uses = [
  ['Online shops', 'Take payments at checkout without building a payment system.'],
  ['Shops and services', 'Send a Payment Link to a customer and get paid on the spot.'],
  ['Schools and clubs', 'Collect fees and dues, and see who has paid.'],
  ['Events', 'Sell tickets and registrations online or through a USSD code.'],
  ['Utilities and subscriptions', 'Collect recurring and one-off payments reliably.'],
  ['NGOs and communities', 'Receive contributions from anyone, on any phone.'],
];

const faqs = [
  ['Which payment methods can my customers use?', 'Customers can pay with mobile money, cards and bank transfers. The exact networks and banks available are confirmed when you open your account.'], // TODO(verify)
  ['Do I need a website to use BizCollect?', 'No. You can share a Payment Link or a USSD code without a website. If you do have a website or app, use Hosted Checkout or the API.'],
  ['How long until I get my money?', 'You can follow every payment on your dashboard as it happens. Settlement timing depends on your account setup and is confirmed during onboarding.'], // TODO(verify): settlement timing
  ['Can I pay out money too?', 'Yes. BizCollect includes payouts, so you can send money to suppliers, staff or customers from the same dashboard.'],
  ['Is there a sandbox to test the API?', 'Yes. Request sandbox access and test your integration before going live.'], // TODO(verify): sandbox availability
  ['What does it cost?', 'Pricing depends on your business and volumes. Talk to our team for a quote, or see our pricing page.'], // TODO(verify): publish rates?
];

const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Business', item: 'https://eganow.com/business' },
  { '@type': 'ListItem', position: 2, name: 'BizCollect', item: 'https://eganow.com/business/bizcollect' },
] };
const bars = [34, 52, 41, 66, 58, 82, 71, 90, 63, 77, 95, 84];
const txs = [
  ['Kofi M.', 'Mobile money', 'GHS 250.00', 'Paid'],
  ['Ama A.', 'Card', 'GHS 1,200.00', 'Paid'],
  ['Yaw B.', 'Payment Link', 'GHS 85.00', 'Pending'],
  ['Efua T.', 'USSD', 'GHS 40.00', 'Paid'],
];
---
<Base world="business" title="BizCollect — Get paid in seconds | Eganow Business" description="Collect payments with the Eganow API, Hosted Checkout, Payment Links or USSD. Pay out and track every transaction on one dashboard.">
  <script type="application/ld+json" set:html={JSON.stringify(crumbs)} slot="head" />
  <Header world="business" />
  <main id="main">
    <ServiceHero crumb="BizCollect" overline="BizCollect" title="Get paid in seconds." titleId="bc-title"
      body="Collect payments from your customers, pay out when you need to, and watch every transaction on one dashboard." s3={s3}>
      <BizVisuals name="collect" />
    </ServiceHero>

    <!-- FOUR WAYS TO COLLECT -->
    <section class="ways" aria-labelledby="ways-t">
      <div class="wrap">
        <p class="overline">Collections</p>
        <h2 id="ways-t" class="display-lg">Four ways to get paid.</h2>
        <p class="body-lg lead">Pick the one that fits. Use them together if you like.</p>

        <div class="tabs" data-tabs>
          <div class="tablist" role="tablist" aria-label="Ways to collect payments">
            {tabs.map((t, i) => (
              <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
            ))}
          </div>

          {tabs.map((t, i) => (
            <div class="tabpanel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} tabindex="0">
              <div class="tp__copy">
                <h3 class="heading-2">{t.title}</h3>
                <p class="body-lg">{t.body}</p>
                <a class="more" href={t.cta[1]}>{t.cta[0]} <span aria-hidden="true">→</span></a>
              </div>
              <div class="tp__vis" aria-hidden={t.id === 'api' ? undefined : 'true'}>
                {t.id === 'api' && (
                  <div class="code">
                    <div class="code__bar"><span>Illustrative example</span><button type="button" data-copy="#api-snippet">Copy</button></div>
                    <pre><code id="api-snippet">{apiSnippet}</code></pre>
                  </div>
                )}
                {t.id === 'checkout' && (
                  <div class="mock mock--checkout">
                    <p class="t">Pay Kente Shop</p><p class="amt">GHS 250.00</p>
                    <ul class="chips"><li class="on">Mobile money</li><li>Card</li><li>Bank</li></ul>
                    <div class="field"><span>Phone number</span><b>024 000 0000</b></div>
                    <div class="btn btn--blue-solid">Pay GHS 250.00</div>
                    <p class="lock">Secured by Eganow</p>
                  </div>
                )}
                {t.id === 'link' && (
                  <div class="mock mock--link">
                    <p class="t">Create payment link</p>
                    <div class="field"><span>Amount</span><b>GHS 85.00</b></div>
                    <div class="field"><span>For</span><b>Table booking</b></div>
                    <div class="btn btn--blue-solid">Create link</div>
                    <div class="linkres"><i class="ok">✓</i><span>Link ready<b>Copy and share on WhatsApp, SMS or email</b></span></div>
                  </div>
                )}
                {t.id === 'ussd' && (
                  <div class="phoneusd">
                    <div class="usd"><p class="usd__top">USSD</p>
                      <p>Dial <b>*000#</b></p><p>1. Pay a merchant</p><p>2. Enter merchant code</p><p>3. Enter amount</p><p>4. Approve with PIN</p>
                      <p class="usd__ok">Payment confirmed.</p></div>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Steps overline="How it works" title="Four steps to your first payment." id="how-t" steps={steps} />

    <!-- PAYOUTS + DASHBOARD -->
    <section class="ops" aria-labelledby="ops-t">
      <div class="wrap">
        <p class="overline">Payouts and dashboard</p>
        <h2 id="ops-t" class="display-lg">Money in. Money out. All in sight.</h2>
        <div class="ops__grid">
          <article class="opcard">
            <h3 class="heading-3">Pay out in a few clicks.</h3>
            <p>Send money to suppliers, staff or customers straight from your dashboard.</p>
            <div class="mock mock--payout" aria-hidden="true">
              <p class="t">Bulk payout · 3 recipients</p>
              <ul><li><span class="av">A</span>Ama A.<b>GHS 1,200.00</b></li><li><span class="av">K</span>Kofi M.<b>GHS 800.00</b></li><li><span class="av">E</span>Efua T.<b>GHS 450.00</b></li></ul>
              <div class="tot"><span>Total</span><b>GHS 2,450.00</b></div>
              <div class="btn btn--blue-solid">Send payouts</div>
            </div>
          </article>
          <article class="opcard opcard--wide">
            <h3 class="heading-3">See every transaction.</h3>
            <p>Track payments by channel, search any transaction and keep your books tidy.</p>
            <div class="mock mock--dash" aria-hidden="true">
              <div class="dash__top"><div><p class="t">Collected this month</p><p class="amt">GHS 48,200</p></div><span class="chip">Mobile money · Card · Bank · Link · USSD</span></div>
              <div class="dbars">{bars.map((h, i) => <i style={`--h:${h}%;--d:${i * 0.08}s`}></i>)}</div>
              <table><tbody>{txs.map(([n, m, a, s]) => <tr><td>{n}</td><td>{m}</td><td class="r">{a}</td><td><span class:list={['st', { pend: s === 'Pending' }]}>{s === 'Paid' ? '✓ ' : '… '}{s}</span></td></tr>)}</tbody></table>
            </div>
            <p class="sr-only">Example dashboard showing collections by channel and a list of recent transactions with their status.</p>
          </article>
        </div>
      </div>
    </section>

    <CardGrid overline="Who it’s for" title="Made for how Ghana pays." id="uses-t" items={uses} />
    <PriceTeaser body="No surprises. Tell us how you collect and we’ll show you exactly what you pay." />
    <Faq items={faqs} />
    <FinalCta title="Ready to get paid?" />
  </main>
  <Footer />
</Base>

<style>
  .t { font: 600 12px/16px var(--font-display); letter-spacing: .06em; text-transform: uppercase; color: var(--neutral-600); margin: 0; }
  .amt { font: 600 32px/40px var(--font-display); letter-spacing: -.01em; font-variant-numeric: tabular-nums; margin: 2px 0 0; }

  section.ways, section.ops { padding: var(--space-24) 0; }

  /* TABS (all panels visible without JS; script turns them into tabs) */
  .tabs { margin-top: var(--space-8); }
  .tablist { display: none; gap: 6px; padding: 5px; background: var(--neutral-200); border-radius: var(--radius-full); width: max-content; max-width: 100%; overflow-x: auto; }
  .tablist button { font: 600 14px/1 var(--font-display); padding: 12px 18px; border: 0; border-radius: var(--radius-full); background: transparent; color: var(--text-muted); cursor: pointer; white-space: nowrap; min-height: 44px; }
  .tablist button[aria-selected="true"] { background: var(--eganow-blue); color: var(--neutral-950); }
  .tabs.ready .tablist { display: flex; }
  @media (max-width: 639px) {
    .tabs.ready .tablist { display: grid; grid-template-columns: 1fr 1fr; width: 100%; border-radius: var(--radius-md); overflow: visible; }
    .tablist button { border-radius: 12px; }
    .tabs.ready .tabpanel { padding: var(--space-6) var(--space-4); }
    .opcard { padding: var(--space-6) var(--space-4); }
    .mock--dash td:nth-child(2) { display: none; }
  }
  .tabpanel { display: grid; gap: var(--space-8); align-items: center; padding: var(--space-8) 0; }
  .tabs.ready .tabpanel { margin-top: var(--space-6); padding: var(--space-8); background: var(--surface-raised); border: 1px solid var(--border); border-radius: var(--radius-lg); }
  .tabs.ready .tabpanel[hidden] { display: none; }
  .tp__copy { display: grid; gap: var(--space-4); justify-items: start; }
  .tp__vis { display: grid; place-items: center; min-height: 280px; padding: var(--space-6); border-radius: var(--radius-md); background: linear-gradient(135deg, var(--eganow-blue), #0b4f99); min-width: 0; }
  @media (min-width: 900px) { .tabpanel { grid-template-columns: 1fr 1.1fr; } }

  .mock { width: min(100%, 340px); background: #fff; border-radius: var(--radius-md); padding: 20px; display: grid; gap: 12px; box-shadow: 0 24px 50px -12px rgb(10 13 20 / .45); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; } .chips li { padding: 6px 12px; border-radius: 99px; background: var(--neutral-100); font: 500 13px/20px var(--font-display); } .chips li.on { background: var(--eganow-blue); color: var(--neutral-950); }
  .field { display: grid; gap: 2px; padding: 10px 12px; border: 1px solid var(--border-strong); border-radius: 12px; } .field span { font-size: 12px; color: var(--text-subtle); } .field b { font: 600 15px/20px var(--font-display); }
  .mock .btn { justify-content: center; min-height: 44px; } .lock { font-size: 12px; color: var(--text-subtle); text-align: center; margin: 0; }
  .ok { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: #12805c; color: #fff; font-style: normal; font-size: 13px; flex: none; }
  .linkres { display: flex; gap: 10px; align-items: center; padding: 10px 12px; border-radius: 12px; background: var(--neutral-100); } .linkres span { display: grid; font: 600 14px/20px var(--font-display); } .linkres b { font: 400 12px/16px var(--font-sans); color: var(--text-muted); }
  .phoneusd { width: 200px; padding: 14px 12px 22px; border-radius: 28px; background: linear-gradient(160deg, #2b3340, #0a0d14); box-shadow: 0 24px 50px -12px rgb(0 0 0 / .6); }
  .usd { background: #d9f0ff; color: var(--neutral-950); border-radius: 10px; padding: 14px; font: 500 13px/20px ui-monospace, Menlo, Consolas, monospace; display: grid; gap: 4px; min-height: 220px; align-content: start; }
  .usd p { margin: 0; } .usd__top { font-weight: 700; letter-spacing: .1em; font-size: 11px; } .usd__ok { margin-top: 8px !important; font-weight: 700; }

  .code { width: 100%; background: var(--neutral-950); border: 1px solid var(--neutral-700); border-radius: var(--radius-md); overflow: hidden; min-width: 0; }
  .code__bar { display: flex; justify-content: space-between; align-items: center; padding: 10px 16px; border-bottom: 1px solid var(--neutral-700); font-size: 12px; color: var(--neutral-400); }
  .code__bar button { font: 600 12px/1 var(--font-display); color: #fff; background: var(--neutral-700); border: 0; border-radius: 99px; padding: 8px 14px; cursor: pointer; min-height: 32px; }
  pre { margin: 0; padding: 16px; overflow-x: auto; font: 400 13px/21px ui-monospace, "SF Mono", Menlo, Consolas, monospace; color: #cfe5ff; }

  /* OPS */
  .ops__grid { margin-top: var(--space-12); display: grid; gap: var(--space-6); }
  .opcard { display: grid; gap: var(--space-3); align-content: start; padding: var(--space-8); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface-raised); } .opcard > p { margin: 0; color: var(--text-muted); }
  .opcard .mock { width: 100%; max-width: none; margin-top: var(--space-4); background: var(--neutral-50); box-shadow: none; border: 1px solid var(--border); }
  .mock--payout ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; } .mock--payout li { display: flex; align-items: center; gap: 10px; font: 500 14px/20px var(--font-display); } .mock--payout li b { margin-left: auto; font-variant-numeric: tabular-nums; }
  .av { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--neutral-800); color: #fff; font: 600 12px/1 var(--font-display); }
  .tot { display: flex; justify-content: space-between; padding-top: 10px; border-top: 1px solid var(--border); font: 600 15px/20px var(--font-display); }
  .dash__top { display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; align-items: flex-start; } .chip { font: 500 12px/16px var(--font-display); padding: 6px 12px; border-radius: 99px; background: var(--neutral-200); }
  .dbars { display: flex; align-items: flex-end; gap: 6px; height: 110px; } .dbars i { flex: 1; height: var(--h); background: var(--eganow-blue); border-radius: 4px; transform-origin: bottom; animation: gr 4s var(--ease-out) var(--d) infinite; }
  @keyframes gr { 0% { transform: scaleY(.2); } 35%, 85% { transform: scaleY(1); } 100% { transform: scaleY(.2); } }
  table { width: 100%; border-collapse: collapse; font: 400 13px/20px var(--font-sans); } td { padding: 8px 4px; border-top: 1px solid var(--border); } td.r { text-align: right; font-variant-numeric: tabular-nums; }
  .st { white-space: nowrap; font: 600 12px/16px var(--font-display); padding: 3px 10px; border-radius: 99px; background: #d7f2e6; color: #0b5b40; } .st.pend { background: #fdf0c8; color: #6b4a00; }
  @media (min-width: 900px) { .ops__grid { grid-template-columns: 1fr 1.4fr; } }

    @media (prefers-reduced-motion: reduce) { .dbars i { animation: none; } }
</style>

<script>
  import '../../scripts/copy';
  import '../../scripts/tabs';
</script>
