---
interface Props { overline: string; title: string; id: string; steps: ReadonlyArray<readonly [string, string]>; }
const { overline, title, id, steps } = Astro.props;
---
<section class="how" aria-labelledby={id}>
  <div class="wrap">
    <p class="overline">{overline}</p>
    <h2 id={id} class="display-lg">{title}</h2>
    <ol class="steps">{steps.map(([h, p], i) => (
      <li style={`--i:${i}`}><span class="num" aria-hidden="true">{i + 1}</span><h3 class="heading-4">{h}</h3><p>{p}</p></li>
    ))}</ol>
  </div>
</section>
<style>
  .how { padding: var(--space-24) 0; }
  .how { background: var(--surface-sunken); }
  .steps { list-style: none; margin: var(--space-12) 0 0; padding: 0; display: grid; gap: var(--space-6); counter-reset: s; }
  .steps li { position: relative; display: grid; gap: 6px; padding-left: 64px; }
  .steps li::before { content: ""; position: absolute; left: 21px; top: 44px; bottom: -28px; width: 2px; background: var(--eganow-blue); opacity: .35; } .steps li:last-child::before { display: none; }
  .steps p { margin: 0; color: var(--text-muted); }
  .num { position: absolute; left: 0; top: 0; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--eganow-blue); color: var(--neutral-950); font: 700 18px/1 var(--font-display); }
  @media (min-width: 900px) {
    .steps { grid-template-columns: repeat(4, 1fr); gap: var(--space-8); }
    .steps li { padding: 60px 0 0; } .steps li::before { left: 56px; right: -32px; top: 21px; bottom: auto; width: auto; height: 2px; }
  }
  @supports (animation-timeline: view()) {
    .steps li { animation: rise both var(--ease-out); animation-timeline: view(); animation-range: entry 0% entry 60%; }
    @keyframes rise { from { opacity: 0; translate: 0 24px; } }
  }

  @media (prefers-reduced-motion: reduce) { .steps li { animation: none; } }
</style>
