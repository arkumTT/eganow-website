---
// Illustrative POS devices drawn in CSS (no image weight). Swap for real device renders when available.
interface Props { variant: 'handheld' | 'counter' | 'mini'; }
const { variant } = Astro.props;
const keys = Array.from({ length: 12 });
---
<div class={`dv dv--${variant}`} aria-hidden="true">
  <div class="shadow"></div>
  {variant === 'handheld' && (<>
    <div class="paper"><b>EGAPOS</b><span>Total</span><b>GHS 85.00</b></div>
    <div class="body">
      <div class="scr"><small>Amount</small><b>GHS 85.00</b><em>Tap card to pay</em></div>
      <div class="keys">{keys.map(() => <i></i>)}</div>
      <div class="tapzone"><i></i><i></i><i></i></div>
    </div>
  </>)}
  {variant === 'counter' && (<>
    <div class="stand"></div>
    <div class="screen"><small>Amount</small><b>GHS 240.00</b><em>Insert, tap or swipe</em></div>
    <div class="base"><div class="keys">{keys.map(() => <i></i>)}</div><div class="slot"></div></div>
  </>)}
  {variant === 'mini' && (
    <div class="body">
      <div class="scr"><small>Amount</small><b>GHS 20.00</b></div>
      <div class="tapzone big"><i></i><i></i><i></i></div>
      <div class="led"></div>
    </div>
  )}
</div>
<style>
  .dv { position: relative; width: 100%; aspect-ratio: 1; font: 500 3cqw/1.2 var(--font-display); color: var(--neutral-950); container-type: inline-size; }
  .shadow { position: absolute; left: 22%; right: 22%; bottom: 3%; height: 5%; border-radius: 50%; background: rgb(10 13 20 / .45); filter: blur(10px); }
  .body, .base { background: linear-gradient(160deg, #323b49, #0a0d14); box-shadow: 0 5cqw 9cqw -2cqw rgb(0 0 0 / .6), inset 0 0 0 .5cqw #475161; }
  .scr, .screen { background: #d9f0ff; border-radius: 2.4cqw; padding: 2.6cqw; display: grid; gap: .6cqw; } .scr small, .screen small { font-size: 2.2cqw; } .scr b, .screen b { font-size: 5.6cqw; } .scr em, .screen em { font: 500 2.3cqw var(--font-sans); font-style: normal; }
  .keys { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6cqw; } .keys i { height: 4.4cqw; border-radius: 1.4cqw; background: #475161; }
  .tapzone { display: flex; justify-content: center; gap: 1.4cqw; padding: 1.4cqw 0; } .tapzone i { width: 2cqw; height: 7cqw; border-right: .9cqw solid var(--eganow-blue); border-radius: 50%; opacity: .9; }
  .tapzone.big { padding: 6cqw 0; } .tapzone.big i { height: 12cqw; width: 3.4cqw; border-right-width: 1.2cqw; }

  /* handheld */
  .dv--handheld .body { position: absolute; left: 29%; top: 10%; width: 42%; height: 84%; border-radius: 5.6cqw; padding: 3.4cqw; display: flex; flex-direction: column; gap: 2.4cqw; z-index: 1; }
  .dv--handheld .keys { flex: 1; align-content: stretch; } .dv--handheld .keys i { height: auto; }
  .dv--handheld .paper { position: absolute; left: 36%; top: 1%; width: 26%; padding: 2cqw; background: #fff; border-radius: 1cqw; display: grid; gap: .6cqw; font-size: 2cqw; color: var(--neutral-600); animation: print 5s var(--ease-out) infinite; z-index: 0; } .paper b { color: var(--neutral-900); }
  @keyframes print { 0%, 30% { transform: translateY(8cqw); } 55%, 100% { transform: translateY(-4cqw); } }

  /* countertop */
  .dv--counter .stand { position: absolute; left: 44%; width: 12%; top: 56%; height: 24%; background: linear-gradient(90deg, #1b212b, #3a4351, #1b212b); }
  .dv--counter .screen { position: absolute; left: 14%; top: 8%; width: 72%; height: 44%; border-radius: 4cqw; padding: 5cqw; background: #d9f0ff; box-shadow: 0 0 0 2cqw #1b212b, 0 6cqw 10cqw -2cqw rgb(0 0 0 / .55); align-content: center; } .dv--counter .screen b { font-size: 9cqw; }
  .dv--counter .base { position: absolute; left: 20%; bottom: 7%; width: 60%; height: 26%; border-radius: 4cqw; padding: 3.4cqw; display: flex; gap: 3cqw; align-items: center; } .dv--counter .keys { flex: 1; } .dv--counter .slot { width: 12%; height: 70%; border-radius: 1cqw; background: #05070b; box-shadow: inset 0 0 0 .5cqw #475161; }

  /* mini */
  .dv--mini .body { position: absolute; left: 24%; top: 18%; width: 52%; height: 64%; border-radius: 7cqw; padding: 4cqw; display: flex; flex-direction: column; gap: 3cqw; }
  .dv--mini .led { align-self: center; width: 6cqw; height: 6cqw; border-radius: 50%; background: #12c28b; box-shadow: 0 0 3cqw #12c28b; animation: pulse 2.4s ease-in-out infinite; } @keyframes pulse { 50% { opacity: .35; } }

  @media (prefers-reduced-motion: reduce) { .paper, .led { animation: none !important; } }
</style>
