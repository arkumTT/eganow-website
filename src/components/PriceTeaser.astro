---
// Decision: there is no public pricing page. With no `href` this shows a single "Get a quote" button;
// a page may pass its own `href` + `ctaLabel` (e.g. Agency Banking) to get a second button.
interface Props { overline?: string; title?: string; body?: string; href?: string; ctaLabel?: string; quoteLabel?: string; }
const { overline = 'Pricing', title = 'Simple, clear pricing.', body = 'No surprises. Tell us what you need and we’ll show you exactly what you pay.', href, ctaLabel = 'See more', quoteLabel = 'Get a quote' } = Astro.props;
---
<section class="price" aria-labelledby="price-t">
  <div class="wrap price__in">
    <div>
      <p class="overline">{overline}</p>
      <h2 id="price-t" class="display-lg">{title}</h2>
      <p class="body-lg">{body}</p>
    </div>
    <div class="cta">{href ? <><a class="btn btn--blue-solid" href={href}>{ctaLabel}</a><a class="btn btn--ghost-inv" href="/contact?topic=sales">{quoteLabel}</a></> : <a class="btn btn--blue-solid" href="/contact?topic=sales">{quoteLabel}</a>}</div>
  </div>
</section>
<style>
  .price { padding: var(--space-24) 0; }
  .price { background: var(--neutral-900); color: #fff; } .price .overline { color: var(--neutral-300); } .price .body-lg { color: var(--neutral-300); margin-top: var(--space-3); }
  .price__in { display: grid; gap: var(--space-6); align-items: center; } .price__in .display-lg { margin-top: var(--space-3); }
  @media (min-width: 900px) { .price__in { grid-template-columns: 1.4fr 1fr; } .price .cta { justify-content: flex-end; margin-top: 0; } }

</style>
