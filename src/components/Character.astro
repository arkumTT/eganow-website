---
// "Ega": photographic guide (African woman, studio cut-out) who walks both worlds.
// Personal = red scarf, Business = blue scarf. The two files are the same photo; the story crossfades them.
// Generated with Magnific; confirm usage rights/likeness policy before launch (see PLAN.md 5.2).
const sizes = '(max-width: 899px) 70px, 250px';
---
<div class="ega" aria-hidden="true">
  <img class="ega__img ega__img--personal" src="/images/ega-personal-420.webp" srcset="/images/ega-personal-420.webp 420w, /images/ega-personal-832.webp 832w" sizes={sizes}
    width="420" height="630" alt="" decoding="async" fetchpriority="low" />
  <img class="ega__img ega__img--business" src="/images/ega-business-420.webp" srcset="/images/ega-business-420.webp 420w, /images/ega-business-832.webp 832w" sizes={sizes}
    width="420" height="630" alt="" decoding="async" loading="lazy" />
</div>
<style>
  .ega { position: relative; width: 100%; aspect-ratio: 2 / 3; transform-origin: 50% 100%; }
  .ega::after { content: ""; position: absolute; left: 12%; right: 12%; bottom: -1.5%; height: 4%; border-radius: 50%; background: rgb(10 13 20 / .35); filter: blur(6px); z-index: -1; }
  .ega__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 14px 18px rgb(10 13 20 / .3)); }
  .ega__img--business { opacity: 0; }
  :global(.live) .ega { animation: breathe 4.2s var(--ease-inout) infinite; }
  @keyframes breathe { 50% { transform: translateY(-4px) scale(1.01); } }
  @media (prefers-reduced-motion: reduce) { :global(.live) .ega { animation: none; } }
</style>
