---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { LEGAL_DRAFT, LEGAL_DRAFT_DATE, LEGAL_DOCS } from '../data/legal-status';
import { fmt, assertNoPlaceholders } from '../lib/text';

// A legal section: heading + paragraphs, optionally a bulleted list after the paragraphs.
// Text may contain [[placeholders]] which render as highlighted marks so none can slip through unnoticed.
export interface LegalSection { id: string; title: string; paras?: string[]; list?: string[]; after?: string[] }
interface Props { title: string; description: string; intro: string; sections: LegalSection[]; slug: string }
const { title, description, intro, sections, slug } = Astro.props;

assertNoPlaceholders(`Legal document "${title}"`, { intro, sections }, LEGAL_DRAFT);
const others = LEGAL_DOCS.filter((d) => d.href !== `/legal/${slug}`);
---
<Base title={`${title} | Eganow`} description={description} noindex={LEGAL_DRAFT}>
  <Header world="neutral" />
  <main id="main">
    <section class="lh" aria-labelledby="lh-t">
      <div class="lh__in">
        <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/legal">Legal</a></li><li aria-current="page">{title}</li></ol></nav>
        <h1 id="lh-t" class="display-lg">{title}</h1>
        <p class="body-lg" set:html={fmt(intro)} />
        {LEGAL_DRAFT && (
          <div class="draft" role="note">
            <b>Draft for legal review.</b> This document is not yet in force. Items highlighted <mark class="todo">like this</mark> are placeholders Eganow must complete before publication. Draft dated {LEGAL_DRAFT_DATE}.
          </div>
        )}
      </div>
    </section>

    <div class="lg">
      <aside class="toc" aria-label="On this page">
        <details open>
          <summary>On this page</summary>
          <ol>{sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}</ol>
        </details>
      </aside>

      <article class="doc">
        {sections.map((s) => (
          <section id={s.id} aria-labelledby={`${s.id}-h`}>
            <h2 id={`${s.id}-h`}>{s.title}</h2>
            {s.paras?.map((p) => <p set:html={fmt(p)} />)}
            {s.list && <ul>{s.list.map((li) => <li set:html={fmt(li)} />)}</ul>}
            {s.after?.map((p) => <p set:html={fmt(p)} />)}
          </section>
        ))}

        <nav class="related" aria-label="Other legal documents">
          <h2>Other legal documents</h2>
          <ul>{others.map((d) => <li><a href={d.href}>{d.title}</a><span>{d.blurb}</span></li>)}</ul>
        </nav>
      </article>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .lh { background: var(--surface); border-bottom: 1px solid var(--border); }
  .lh__in { max-width: 1240px; margin: 0 auto; padding: var(--space-12) clamp(16px, 4vw, 48px) var(--space-8); display: grid; gap: var(--space-4); }
  .lh__in > * { max-width: 760px; }
  .crumbs ol { list-style: none; margin: 0; padding: 0; display: flex; gap: 8px; font: 500 13px/20px var(--font-display); color: var(--text-muted); }
  .crumbs li + li::before { content: "/"; margin-right: 8px; color: var(--neutral-400); } .crumbs a { text-decoration: none; } .crumbs a:hover { text-decoration: underline; }
  .draft { padding: 14px 16px; border: 2px solid #b45309; border-radius: 12px; background: #fffbeb; color: #5c3b00; font-size: 14px; line-height: 20px; }
  :global(mark.todo) { background: #fde68a; color: #422d00; padding: 0 4px; border-radius: 4px; font-weight: 600; }

  .lg { max-width: 1240px; margin: 0 auto; padding: var(--space-8) clamp(16px, 4vw, 48px) var(--space-24); display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-8); align-items: start; }
  .toc { background: var(--surface-raised); border: 1px solid var(--border); border-radius: var(--radius-md); }
  .toc summary { cursor: pointer; padding: 14px 18px; font: 600 14px/20px var(--font-display); min-height: 44px; list-style: none; display: flex; justify-content: space-between; }
  .toc summary::-webkit-details-marker { display: none; } .toc summary::after { content: "+"; } .toc details[open] summary::after { content: "–"; }
  .toc ol { margin: 0; padding: 0 18px 14px 40px; display: grid; gap: 2px; font-size: 14px; line-height: 20px; }
  .toc a { display: block; padding: 6px 0; text-decoration: none; color: var(--text-muted); } .toc a:hover { color: var(--text); text-decoration: underline; }
  @media (min-width: 960px) { .lg { grid-template-columns: 280px minmax(0, 1fr); } .toc { position: sticky; top: calc(var(--header-h) + var(--space-6)); max-height: calc(100svh - var(--header-h) - 48px); overflow: auto; } }

  .doc { max-width: 760px; counter-reset: sec; }
  .doc section { counter-increment: sec; padding-top: var(--space-8); }
  .doc section:first-child { padding-top: 0; }
  .doc h2 { font: 600 clamp(22px, 2.6vw, 26px)/1.3 var(--font-display); letter-spacing: -.01em; margin: 0 0 var(--space-3); }
  .doc section h2::before { content: counter(sec) ". "; color: var(--text-subtle); }
  .doc p, .doc li { font-size: 16px; line-height: 26px; color: var(--text); }
  .doc p { margin: 0 0 var(--space-3); } .doc ul { margin: 0 0 var(--space-3); padding-left: 22px; display: grid; gap: 6px; }
  .doc a { text-decoration: underline; text-underline-offset: 3px; }
  .related { margin-top: var(--space-16); padding-top: var(--space-8); border-top: 1px solid var(--border); }
  .related h2 { font: 600 20px/28px var(--font-display); margin: 0 0 var(--space-4); } .related h2::before { content: none !important; }
  .related ul { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); } .related li { display: grid; gap: 2px; padding: 0; } .related a { font: 600 16px/24px var(--font-display); } .related span { color: var(--text-muted); font-size: 14px; line-height: 20px; }

  @media print { :global(.hdr), :global(.ft), .toc, .related, .draft { display: none !important; } .lg { display: block; padding: 0; } .doc { max-width: none; } }
</style>
