---
// HTML phone screens (crisp, tiny, themeable). Illustrative content only: no real rates/fees.
interface Props { name: 'home' | 'tx' | 'bills' | 'cards' | 'groups' | 'trust' | 'download'; }
const { name } = Astro.props;
const bills = ['Electricity', 'Water', 'Airtime', 'TV', 'Internet', 'Fuel'];
---
{name === 'home' && <div class="scr scr--home">
  <p class="scr__hi">Good morning, Ama</p>
  <p class="scr__lbl">Total balance</p>
  <p class="scr__amt">GHS 12,450.00</p>
  <ul class="scr__acts"><li>Send</li><li>Pay</li><li>Card</li><li>Groups</li></ul>
  <div class="scr__card"><span>Mastercard</span><b>•••• 4821</b></div>
</div>}
{name === 'tx' && <div class="scr scr--tx">
  <p class="scr__title">Send money</p>
  <div class="scr__row"><span class="av">K</span><div><b>Kofi Mensah</b><small>Accra · Mobile money</small></div></div>
  <p class="scr__lbl">You send</p><p class="scr__amt">GHS 500.00</p>
  <div class="scr__fx"><span>Arrives</span><b>In minutes</b></div>
  <div class="scr__cta">Send now</div>
  <p class="scr__done">✓ Sent</p>
</div>}
{name === 'bills' && <div class="scr scr--bills">
  <p class="scr__title">Pay bills</p>
  <ul class="scr__grid">{bills.map((b) => <li><i></i>{b}</li>)}</ul>
  <div class="scr__row"><span class="av">⚡</span><div><b>Electricity</b><small>Meter ••• 3920</small></div></div>
  <div class="scr__cta">Pay GHS 120.00</div>
</div>}
{name === 'cards' && <div class="scr scr--cards">
  <p class="scr__title">My cards</p>
  <div class="cardv"><span class="net"><i></i><i></i></span><small>Virtual · Ready to use</small><b>•••• 4821</b><em>Ama Mensah</em></div>
  <div class="scr__row sw"><div><b>Freeze card</b><small>Pause spending instantly</small></div><span class="tgl"><i></i></span></div>
  <div class="scr__fx"><span>Monthly limit</span><b>GHS 5,000</b></div>
  <div class="scr__cta">Order physical card</div>
</div>}
{name === 'groups' && <div class="scr scr--groups">
  <p class="scr__title">Family Fund</p>
  <div class="seg"><span class="on">Private</span><span>Public</span></div>
  <div class="ring"><div><b>68%</b><small>of GHS 10,000</small></div></div>
  <ul class="avs"><li>A</li><li>K</li><li>E</li><li>+5</li></ul>
  <div class="scr__fx"><span>Raised so far</span><b>GHS 6,800</b></div>
  <div class="scr__cta">Contribute</div>
</div>}
{name === 'trust' && <div class="scr scr--trust">
  <p class="scr__title">Security</p>
  <div class="shield"><svg viewBox="0 0 48 56" aria-hidden="true"><path d="M24 2 4 9v17c0 13 8.6 23.7 20 28 11.4-4.3 20-15 20-28V9z" fill="#cc0229"/><path d="m15 28 7 7 12-14" fill="none" stroke="#fff" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/></svg><b>You're protected</b></div>
  <ul class="sec">
    <li><i>✓</i><div><b>Licensed</b><small>Bank of Ghana regulated</small></div></li>
    <li><i>✓</i><div><b>PIN &amp; fingerprint</b><small>Only you can sign in</small></div></li>
    <li><i>✓</i><div><b>Instant freeze</b><small>Lock your card in one tap</small></div></li>
    <li><i>✓</i><div><b>Encrypted</b><small>Every transaction, end to end</small></div></li>
  </ul>
</div>}
{name === 'download' && <div class="scr scr--download">
  <div class="splash__mark">e</div>
  <p class="splash__name">eganow</p>
  <ul class="splash__3s"><li>Simple.</li><li>Speed.</li><li>Secure.</li></ul>
  <div class="splash__btn">Get started</div>
</div>}
<style>
  /* Screens are laid out at a fixed 252px design width and scaled to whatever phone size holds them */
  :global(.phone__screen:has(> .scr)) { container-type: size; }
  .scr { --k: tan(atan2(100cqw, 252px)); position: absolute; left: 0; top: 0; width: 252px; height: 541px; transform: scale(var(--k)); transform-origin: 0 0; padding: 44px 16px 16px; background: #fff; display: flex; flex-direction: column; gap: 10px; font: 400 12px/16px var(--font-sans); color: var(--text); }
  .scr p, .scr ul { margin: 0; } .scr ul { padding: 0; list-style: none; }
  .scr__hi { font-weight: 500; color: var(--text-muted); } .scr__lbl { color: var(--text-subtle); margin-top: 6px; }
  .scr__amt { font: 600 25px/32px var(--font-display); letter-spacing: -.01em; font-variant-numeric: tabular-nums; }
  .scr__title { font: 600 16px/24px var(--font-display); }
  .scr__acts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .scr__acts li { text-align: center; padding: 10px 0; background: var(--surface-sunken); border-radius: 12px; font: 500 11px/14px var(--font-display); }
  .scr__card { margin-top: auto; height: 96px; border-radius: 16px; padding: 12px; color: #fff; display: flex; flex-direction: column; justify-content: space-between;
    background: linear-gradient(135deg, var(--eganow-red), #7a0118); font: 500 12px/16px var(--font-display); }
  .scr__row { display: flex; gap: 10px; align-items: center; padding: 10px; border: 1px solid var(--border); border-radius: 14px; }
  .scr__row small { display: block; color: var(--text-subtle); } .scr__row b { font: 600 13px/16px var(--font-display); }
  .av { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--eganow-red); color: #fff; font: 600 13px/1 var(--font-display); }
  .scr__fx { display: flex; justify-content: space-between; padding: 10px 12px; background: var(--surface-sunken); border-radius: 12px; }
  .scr__cta { margin-top: auto; text-align: center; padding: 13px; border-radius: 999px; background: var(--eganow-red); color: #fff; font: 600 13px/16px var(--font-display); }
  .scr__done { position: absolute; left: 16px; right: 16px; bottom: 16px; text-align: center; padding: 13px; border-radius: 999px; background: #12805c; color: #fff; font: 600 13px/16px var(--font-display); opacity: 0; transform: translateY(8px); }
  .scr__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .scr__grid li { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 12px 2px; background: var(--surface-sunken); border-radius: 12px; font: 500 10.5px/12px var(--font-display); }
  .scr__grid i { width: 26px; height: 26px; border-radius: 50%; background: var(--eganow-red); opacity: .9; }
  .scr--cards { perspective: 700px; }
  .cardv { position: relative; height: 112px; border-radius: 16px; padding: 12px; color: #fff; display: flex; flex-direction: column; justify-content: flex-end; gap: 2px;
    background: linear-gradient(135deg, #cc0229, #5c0014); box-shadow: 0 10px 24px -8px rgb(204 2 41 / .6); transform-origin: 50% 100%; }
  .cardv small { opacity: .85; font-size: 10.5px; } .cardv b { font: 600 15px/20px var(--font-display); letter-spacing: .08em; } .cardv em { font: 500 10.5px/14px var(--font-display); font-style: normal; opacity: .9; }
  .net { position: absolute; top: 12px; right: 12px; display: flex; } .net i { width: 20px; height: 20px; border-radius: 50%; background: rgb(255 255 255 / .75); } .net i + i { margin-left: -8px; background: rgb(255 255 255 / .45); }
  .sw { justify-content: space-between; } .tgl { position: relative; width: 38px; height: 22px; border-radius: 99px; background: var(--neutral-300); flex: none; } .tgl i { position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: #fff; transition: none; }
  .seg { display: flex; padding: 3px; background: var(--surface-sunken); border-radius: 99px; } .seg span { flex: 1; text-align: center; padding: 7px; border-radius: 99px; font: 500 11px/14px var(--font-display); } .seg .on { background: var(--eganow-red); color: #fff; }
  .ring { --p: 68; align-self: center; width: 128px; height: 128px; border-radius: 50%; display: grid; place-items: center; margin: 4px 0;
    background: conic-gradient(var(--eganow-red) calc(var(--p) * 1%), var(--neutral-200) 0); }
  .ring > div { width: 100px; height: 100px; border-radius: 50%; background: #fff; display: grid; place-content: center; text-align: center; } .ring b { font: 700 24px/28px var(--font-display); } .ring small { color: var(--text-subtle); font-size: 10px; }
  .avs { display: flex; justify-content: center; } .avs li { width: 28px; height: 28px; border-radius: 50%; border: 2px solid #fff; margin-left: -6px; display: grid; place-items: center; font: 600 11px/1 var(--font-display); background: var(--eganow-red); color: #fff; }
  .avs li:nth-child(2) { background: var(--neutral-800); } .avs li:nth-child(3) { background: #ff6b81; } .avs li:nth-child(4) { background: var(--neutral-200); color: var(--neutral-800); }
  .shield { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 14px 0 6px; } .shield svg { width: 56px; height: 64px; } .shield b { font: 600 15px/20px var(--font-display); }
  .sec { display: grid; gap: 8px; } .sec li { display: flex; gap: 10px; align-items: center; padding: 9px 10px; border: 1px solid var(--border); border-radius: 12px; }
  .sec i { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: #12805c; color: #fff; font-style: normal; font-size: 12px; flex: none; }
  .sec b { display: block; font: 600 12.5px/16px var(--font-display); } .sec small { color: var(--text-subtle); font-size: 10.5px; }
  .scr--download { background: linear-gradient(160deg, #cc0229 10%, #7a0118); color: #fff; align-items: center; justify-content: center; text-align: center; gap: 12px; }
  .splash__mark { display: grid; place-items: center; width: 76px; height: 76px; border-radius: 22px; background: #fff; color: #cc0229; font: 700 54px/1 var(--font-display); padding-bottom: 8px; box-shadow: 0 14px 30px rgb(0 0 0 / .3); }
  .splash__name { font: 700 28px/32px var(--font-display); letter-spacing: -.02em; }
  .splash__3s { display: grid; gap: 2px; font: 600 15px/20px var(--font-display); opacity: .92; }
  .splash__btn { position: absolute; left: 16px; right: 16px; bottom: 20px; padding: 13px; border-radius: 99px; background: #fff; color: #cc0229; font: 600 13px/16px var(--font-display); }
</style>
