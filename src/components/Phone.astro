---
interface Props { class?: string; label?: string; }
const { class: cls = '', label = 'Eganow app screen' } = Astro.props;
---
<div class:list={['phone', cls]} aria-hidden="true" data-label={label}>
  <div class="phone__screen"><slot /></div><i class="phone__notch"></i>
</div>
<style>
  .phone { position: relative; width: var(--pw, 260px); aspect-ratio: 9 / 18.6; padding: calc(var(--pw, 260px) * .035); border-radius: calc(var(--pw, 260px) * .17);
    background: linear-gradient(145deg, #2b3340, #0a0d14); box-shadow: var(--shadow-phone), inset 0 0 0 2px #3b4452; will-change: transform; }
  .phone__screen { position: relative; width: 100%; height: 100%; overflow: hidden; border-radius: calc(var(--pw, 260px) * .14); background: #fff; font-size: calc(var(--pw, 260px) / 260 * 12px); }
  .phone__notch { position: absolute; top: calc(var(--pw, 260px) * .05); left: 50%; width: 28%; height: calc(var(--pw, 260px) * .05); transform: translateX(-50%); border-radius: 99px; background: #0a0d14; }
</style>
